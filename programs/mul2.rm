machine Copy(d, s) = struct 
  reg t
  l0 : d- -> l0, l1 
  l1 : s- -> l2, l4 
  l2 : d+ -> l3 
  l3 : t+ -> l1 
  l4 : t- -> l5, l6
  l5 : s+ -> l4 
  l6 : halt
end 

machine Inc(d, s) = struct 
  l0 : s- -> l1, l2
  l1 : d+ -> l0 
  l2 : halt 
end 

reg r0, r1 := 3, r2 := 4, r3 

l0 : r1- -> l1, l3
l1 : execute Copy(r3, r2) -> l2 (* copy r2 into r3 *)
l2 : execute Inc(r0, r3) -> l0
l3 : halt
